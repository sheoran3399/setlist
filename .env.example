# Copy this file to .env and fill in real values. Never commit .env.

AUDD_API_TOKEN=

# From https://console.anthropic.com/settings/keys - used for genre/mood tagging
ANTHROPIC_API_KEY=

# Create a Spotify app at https://developer.spotify.com/dashboard
# Redirect URI must be added there exactly as set here (Spotify requires
# a loopback IP, not "localhost", e.g. http://127.0.0.1:8080/callback).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# For the web app's /playlist page (add-to-playlist). Also add this exact
# URI (with your own host) to the Spotify app's Redirect URIs list.
SPOTIFY_APP_REDIRECT_URI=http://127.0.0.1:5050/callback

# Shared access code gating /playlist, since it writes to Spotify and (once
# deployed) is reachable by anyone with the link. Leave blank to disable.
PLAYLIST_ADD_SECRET=
